# Supabase (needed starting Phase 2 — https://supabase.com, create a free project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage adapter (mock|pinata). Defaults to mock — no key required until Phase 9.
STORAGE_PROVIDER=mock
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY_URL=

# Private Python image-authenticity service. Use the same long random secret
# for the Next.js server and services/ai_checker.
AI_CHECKER_URL=http://127.0.0.1:8001
AI_CHECKER_SHARED_SECRET=replace-with-a-long-random-secret

# Chain adapter (mock|polygon). Defaults to mock — no key required until Phase 9.
CHAIN_PROVIDER=mock
POLYGON_AMOY_RPC_URL=
# Dedicated burner wallet only. NEVER a wallet holding real funds.
CHAIN_DEPLOYER_PRIVATE_KEY=
RECORD_ANCHOR_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_EXPLORER_BASE_URL=https://amoy.polygonscan.com

# Optional — only needed for `hardhat verify` on Amoy
POLYGONSCAN_API_KEY=
